{
  "name": "besnovatyj/yii2-cms-dashboard",
  "description": "Панель главной страницы админки: сбор, включение и упорядочивание плиток-виджетов установленных модулей",
  "type": "yii2-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "extra": {
    "moduleClass": "Besnovatyj\\Dashboard\\Module",
    "moduleId": "Dashboard",
    "bescms": { "kind": "module" },
    "config-plugin": {
      "admin-menu": "src/config/adminMenu.php",
      "common": "src/config/common.php"
    }
  },
  "keywords": [
    "yii2",
    "cms",
    "dashboard",
    "admin"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "fxp-asset": {
      "enabled": false
    }
  },
  "require": {
    "besnovatyj/yii2-cms-kernel": "^1.2",
    "besnovatyj/yii2-cms-contracts": "^3.0",
    "php": ">=8.4",
    "yiisoft/yii2": "~2.0",
    "yiisoft/yii2-bootstrap5": "~2.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\Dashboard\\": "src/"
    }
  }
}
